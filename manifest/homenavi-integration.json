{
  "schema_version": 1,
  "id": "spotify",
  "name": "Spotify",
  "version": "1.0.4",
  "publisher": "Homenavi",
  "homepage": "https://spotify.com",
  "verified": false,
  "ui": {
    "sidebar": {
      "enabled": true,
      "path": "/ui/",
      "label": "Spotify",
      "icon": "fa:spotify"
    },
    "setup": {
      "enabled": true,
      "path": "/ui/setup/",
      "label": "Setup",
      "icon": "fa:spotify"
    }
  },
  "widgets": [
    {
      "type": "integration.spotify.player",
      "display_name": "Spotify Player",
      "description": "Control playback, queue, and devices.",
      "entry": { "kind": "iframe", "url": "/widgets/player/" },
      "requested_scopes": ["integration.spotify.read", "integration.spotify.control"]
    }
  ]
}
